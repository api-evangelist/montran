{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/VirtualAccountBalance",
  "title": "VirtualAccountBalance",
  "type": "object",
  "description": "Virtual account balance information",
  "properties": {
    "accountId": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "availableBalance": {
      "type": "number",
      "format": "double"
    },
    "bookedBalance": {
      "type": "number",
      "format": "double"
    },
    "pendingCredits": {
      "type": "number",
      "format": "double"
    },
    "pendingDebits": {
      "type": "number",
      "format": "double"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    }
  }
}