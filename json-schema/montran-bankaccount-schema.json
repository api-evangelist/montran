    "accountId": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "accountNumber": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "bankId": {
      "type": "string"
    },
    "bankName": {
      "type": "string"
    },
    "bankBic": {
      "type": "string"
    },
    "accountName": {
      "type": "string"
    },
    "availableBalance": {
      "type": "number",
      "format": "double"
    },
    "bookedBalance": {
      "type": "number",
      "format": "double"
    },
