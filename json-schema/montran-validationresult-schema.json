{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ValidationResult",
  "title": "ValidationResult",
  "type": "object",
  "description": "Message validation result",
  "properties": {
    "valid": {
      "type": "boolean",
      "description": "Whether the message is valid"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "ERROR",
              "WARNING"
            ]
          },
          "field": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}