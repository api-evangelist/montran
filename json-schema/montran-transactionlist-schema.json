{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/TransactionList",
  "title": "TransactionList",
  "type": "object",
  "properties": {
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "creditDebit": {
            "type": "string",
            "enum": [
              "CRDT",
              "DBIT"
            ]
          },
          "bookingDate": {
            "type": "string",
            "format": "date"
          },
          "valueDate": {
            "type": "string",
            "format": "date"
          },
          "counterpartyName": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "remittanceInformation": {
            "type": "string"
          }
        }
      }
    },
    "pagination": {
      "$ref": "#/components/schemas/Pagination"
    }
  }
}