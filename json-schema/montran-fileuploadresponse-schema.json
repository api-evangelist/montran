{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FileUploadResponse",
  "title": "FileUploadResponse",
  "type": "object",
  "properties": {
    "fileId": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "UPLOADED",
        "PROCESSING"
      ]
    },
    "uploadedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}