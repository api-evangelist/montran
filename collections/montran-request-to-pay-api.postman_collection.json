          "name": "Montran Initiate a request to pay",
          "request": {
            "name": "Montran Initiate a request to pay",
            "description": {
              "content": "Initiates a request-to-pay (R2P) message to request payment from a debtor. The debtor receives the request and can accept or reject it. Supports person-to-person, person-to-merchant, and business-to-business use cases. Uses ISO 20022 pain.013 CreditorPaymentActivationRequest.",
              "type": "text/plain"
            },
            "url": {
