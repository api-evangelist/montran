{
  "opencollection": "1.0.0",
  "info": {
    "name": "Montran Corporate Payments Portal Account Information Statements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Montran Get account statements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.montran.com/corporate/v1/accounts/:accountId/statements",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the account"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date for filtering (ISO 8601 format)"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date for filtering (ISO 8601 format)"
              }
            ]
          },
          "docs": "Retrieves account statements for a specified date range. Returns statement information aligned with ISO 20022 camt.053 BankToCustomerStatement format including all credit and debit entries, opening and closing balances."
        }
      ]
    }
  ],
  "bundled": true
}