        {
          "id": "566ea09e-f551-4110-b999-10280245d3c5",
          "name": "Montran Create a PSD2 consent",
          "request": {
            "name": "Montran Create a PSD2 consent",
            "description": {
              "content": "Creates a new PSD2 consent for account access (AISP) or payment initiation (PISP). The consent must be authorized by the payment service user (PSU) before it can be used. Supports Strong Customer Authentication (SCA) flows as required by PSD2.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "consents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consentType\": \"<string>\",\n  \"psuId\": \"<string>\",\n  \"accountIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"validUntil\": \"<date>\",\n  \"frequencyPerDay\": \"<integer>\",\n  \"recurringIndicator\": \"<boolean>\"\n}",
